<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SampahKita" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">#43555A</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/green_primary</item>
        <item name="colorSecondaryVariant">#43555A</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <style name="Button.Gray" parent="ThemeOverlay.AppCompat">
        <item name="colorAccent">@android:color/darker_gray</item>
        <item name="background">@drawable/bg_grey_button</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="Button.Green" parent="ThemeOverlay.AppCompat">
        <item name="colorAccent">@color/green_primary</item>
        <item name="textAllCaps">false</item>
        <item name="fontFamily">@font/nobile_bold</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:height">55dp</item>
        <item name="android:background">@drawable/bg_green_button</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="colorButtonNormal">@color/green_primary</item>
    </style>
</resources>